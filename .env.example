# Environment Variables Example for Annapoorni Academy

# Flask Backend Configuration
FLASK_ENV=development
FLASK_APP=backend/app.py
SECRET_KEY=annapoorni-secret-super-key-2026
JWT_SECRET_KEY=annapoorni-jwt-secret-key-production-2026
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Database Configuration (MySQL production or SQLite dev)
# For MySQL: mysql+pymysql://user:password@localhost:3306/annapoorni_db
DATABASE_URL=sqlite:///annapoorni.db

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Admin Initial Credentials (populated on first seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=shinoansonanand@gmail.com
ADMIN_PASSWORD=admin123

# SMTP Email Notification Settings (Optional for live inbox email dispatch)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=shinoansonanand@gmail.com
MAIL_PASSWORD=your_gmail_app_password
