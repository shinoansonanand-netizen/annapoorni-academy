# Production & Development Environment Variables Template for Annapoorni Academy
# DO NOT commit real secrets or passwords to version control!

# Flask Backend Core Settings
FLASK_ENV=production
FLASK_APP=app.py
PORT=5000
SECRET_KEY=your_production_flask_secret_key_here
JWT_SECRET_KEY=your_production_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Production Database Configuration (MySQL using PyMySQL, fallback to local SQLite)
# MySQL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://annapoorni_user:your_secure_db_password@mysql_host:3306/annapoorni_db

# File Upload Settings (Production mount folder path or relative uploads)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Deployed Frontend URL for CORS Security (e.g. Netlify deployment URL)
FRONTEND_URL=https://your-site-name.netlify.app

# Initial Admin Credentials (Seeded on first database startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# SMTP Email Notification Settings (Optional - required only for live SMTP email dispatch)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_email@example.com
MAIL_PASSWORD=your_smtp_app_password
